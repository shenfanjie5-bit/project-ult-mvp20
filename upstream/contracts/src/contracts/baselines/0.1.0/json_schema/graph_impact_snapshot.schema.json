{
  "$defs": {
    "Direction": {
      "description": "\u4fe1\u53f7\u6216 alpha \u65b9\u5411\u3002",
      "enum": [
        "bullish",
        "bearish",
        "neutral"
      ],
      "title": "Direction",
      "type": "string"
    },
    "EntityReference": {
      "additionalProperties": false,
      "description": "Portable reference to a canonical entity across downstream schemas.",
      "properties": {
        "canonical_id_rule_version": {
          "minLength": 1,
          "title": "Canonical Id Rule Version",
          "type": "string"
        },
        "display_name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "entity_id": {
          "minLength": 1,
          "title": "Entity Id",
          "type": "string"
        },
        "entity_type": {
          "minLength": 1,
          "title": "Entity Type",
          "type": "string"
        }
      },
      "required": [
        "entity_id",
        "entity_type",
        "canonical_id_rule_version"
      ],
      "title": "EntityReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Published graph-engine impact snapshot contract.",
  "properties": {
    "affected_entities": {
      "items": {
        "$ref": "#/$defs/EntityReference"
      },
      "title": "Affected Entities",
      "type": "array"
    },
    "affected_sectors": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Affected Sectors",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "cycle_id": {
      "minLength": 1,
      "title": "Cycle Id",
      "type": "string"
    },
    "direction": {
      "$ref": "#/$defs/Direction"
    },
    "evidence_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Evidence Refs",
      "type": "array"
    },
    "impact_score": {
      "maximum": 1.0,
      "minimum": -1.0,
      "title": "Impact Score",
      "type": "number",
      "x-contract-runtime-validation": {
        "allow_inf_nan": false,
        "strict": true
      }
    },
    "impact_snapshot_id": {
      "minLength": 1,
      "title": "Impact Snapshot Id",
      "type": "string"
    },
    "target_entities": {
      "items": {
        "$ref": "#/$defs/EntityReference"
      },
      "minItems": 1,
      "title": "Target Entities",
      "type": "array"
    },
    "version": {
      "minLength": 1,
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "impact_snapshot_id",
    "cycle_id",
    "version",
    "created_at",
    "target_entities",
    "direction",
    "impact_score",
    "evidence_refs"
  ],
  "title": "GraphImpactSnapshot",
  "type": "object",
  "x-contract-version": "0.1.0",
  "x-source-model": "contracts.schemas.graph.GraphImpactSnapshot"
}
