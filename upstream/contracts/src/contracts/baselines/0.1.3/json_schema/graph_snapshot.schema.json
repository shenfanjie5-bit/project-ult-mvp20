{
  "$defs": {
    "EntityReference": {
      "additionalProperties": false,
      "description": "Portable reference to a canonical entity across downstream schemas.",
      "properties": {
        "canonical_id_rule_version": {
          "minLength": 1,
          "title": "Canonical Id Rule Version",
          "type": "string"
        },
        "display_name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "entity_id": {
          "minLength": 1,
          "title": "Entity Id",
          "type": "string"
        },
        "entity_type": {
          "minLength": 1,
          "title": "Entity Type",
          "type": "string"
        }
      },
      "required": [
        "entity_id",
        "entity_type",
        "canonical_id_rule_version"
      ],
      "title": "EntityReference",
      "type": "object"
    },
    "GraphEdge": {
      "additionalProperties": false,
      "description": "Graph edge persisted in a graph snapshot.",
      "properties": {
        "edge_id": {
          "minLength": 1,
          "title": "Edge Id",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "properties": {
          "additionalProperties": true,
          "title": "Properties",
          "type": "object"
        },
        "relation_type": {
          "minLength": 1,
          "title": "Relation Type",
          "type": "string"
        },
        "source_node": {
          "minLength": 1,
          "title": "Source Node",
          "type": "string"
        },
        "target_node": {
          "minLength": 1,
          "title": "Target Node",
          "type": "string"
        }
      },
      "required": [
        "edge_id",
        "source_node",
        "target_node",
        "relation_type"
      ],
      "title": "GraphEdge",
      "type": "object"
    },
    "GraphNode": {
      "additionalProperties": false,
      "description": "Graph node persisted in a graph snapshot.",
      "properties": {
        "entity": {
          "anyOf": [
            {
              "$ref": "#/$defs/EntityReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
