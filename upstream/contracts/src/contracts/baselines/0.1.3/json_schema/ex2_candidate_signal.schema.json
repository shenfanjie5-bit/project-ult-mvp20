  "additionalProperties": false,
  "description": "Ex-2 candidate signal payload.\n\nv0.1.3 changes (backward compatible):\n- ``affected_sectors`` constraint relaxed: ``Field(min_length=1)`` is\n  removed (the list itself no longer requires \u22651 entry); the field\n  remains REQUIRED on the wire (so consumers can still rely on its\n  presence \u2014 they just must accept ``[]``). Sector enrichment is the\n  downstream graph-engine's responsibility, not subsystem ingestion.\n  Existing producers that emit non-empty sectors keep working; new\n  producers (announcement / news) without sector data emit ``[]``.\n  Element-level constraint (each SectorId still ``min_length=1``)\n  preserved \u2014 no truly empty-string sectors allowed.\n- ``producer_context`` added as canonical extension slot (see Ex-1).",
  "properties": {
    "affected_entities": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Affected Entities",
      "type": "array"
    },
    "affected_sectors": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Affected Sectors",
      "type": "array"
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number",
      "x-contract-runtime-validation": {
        "allow_inf_nan": false,
        "strict": true
      }
    },
    "direction": {
      "$ref": "#/$defs/Direction"
    },
    "evidence": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    },
    "magnitude": {
      "minimum": 0.0,
      "title": "Magnitude",
      "type": "number",
      "x-contract-runtime-validation": {
        "allow_inf_nan": false,
        "strict": true
      }
    },
    "producer_context": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Producer Context"
    },
    "signal_id": {
      "minLength": 1,
      "title": "Signal Id",
      "type": "string"
    },
    "signal_type": {
