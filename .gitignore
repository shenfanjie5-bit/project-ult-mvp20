# Frontend lives outside the mvp20 manifest+lock+CI shell — kept locally
# but not version-controlled by the outer mvp20 repo. Was previously a
# nested git repo; that .git was removed so the directory is now plain
# files. Keep ignored to avoid accidentally committing large node_modules
# / build artefacts / Tauri target / generated dist.
FrontEnd/
.DS_Store

# Phase-1 + Phase-2 data layer outputs (collector writes here continuously).
# hot.sqlite holds the current snapshot; history/ holds Parquet minute files
# that get compacted daily. Neither is meaningful to git-track.
runtime/

# Belt-and-braces patterns for the P3-Z2 collector supervisor: even if
# ``runtime/`` is ever un-ignored for a sub-path, the supervisor PID file
# and rotated log artefacts stay ignored.
runtime/*.pid
runtime/*.log
runtime/*.log.*

# Vendored upstream project-ult modules under upstream/ — their source files
# ARE tracked (those define the public API our adapters call), but their
# build / cache / test artefacts and editable-install metadata should not
# pollute mvp20's main git history.
upstream/**/__pycache__/
upstream/**/*.egg-info/
upstream/**/.pytest_cache/
upstream/**/build/
upstream/**/dist/
upstream/**/.venv/
upstream/**/.ruff_cache/
upstream/**/.mypy_cache/
upstream/**/artifacts/

# Claude Code session / plan state (per-user, not portable).
.claude/

# Playwright MCP browser snapshots / console logs from local QA runs.
.playwright-mcp/

# Project-local scratch files (assistant pin'ed CSVs, ad-hoc payloads).
available_complete_interfaces_*.csv

# Isolated quant research (factor_research/): code + reports + small JSON
# results ARE tracked; the research venv, rebuildable binary panels (npz)
# and per-date PIT sqlite snapshots stay local. realbase.sqlite is kept —
# it holds the recomputed historical base_score baseline (expensive to
# regenerate: ~6s/stock x 250 x 14 dates).
factor_research/.venv_research/
factor_research/**/*.npz
factor_research/04_event_study/cache/
factor_research/pit_extra/*
!factor_research/pit_extra/realbase.sqlite
!factor_research/pit_extra/universe_sample.json
!factor_research/pit_extra/realbase_analysis.json

# Assistant/Codex overlay-fill scratch: ad-hoc per-stock *_overlay_patch.yaml
# drafts and closed_loop_*/verify_* sandbox dirs used while iterating on a
# single overlay. Never part of the tracked overlay set under config/.
tmp/
