[Unit]
Description=mvp20 data collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fanjie
WorkingDirectory=/Users/fanjie/Desktop/Cowork/project-ult-mvp20
ExecStart=/Users/fanjie/Desktop/Cowork/project-ult-mvp20/.venv/bin/python scripts/collector.py --source all --interval 60
Restart=always
RestartSec=10
StandardOutput=append:/Users/fanjie/Desktop/Cowork/project-ult-mvp20/runtime/collector.systemd.log
StandardError=append:/Users/fanjie/Desktop/Cowork/project-ult-mvp20/runtime/collector.systemd.log

[Install]
WantedBy=multi-user.target
